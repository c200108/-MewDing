unity/Assets/Rooms/voxel.meta
unity/Assets/Rooms/hd2d/
unity/Assets/Rooms/hd2d.meta
unity/Assets/Rooms/bake_report.txt*
unity/Assets/AddressableAssetsData/Android/
unity/Assets/AddressableAssetsData/Android.meta
unity/Assets/StreamingAssets/aa*
# Blender 便携版（tools/blender/Blender4.0，约 1G，本机工具不进版本库）
tools/blender/Blender4.0/
tools/blender/downloads/
tools/blender/export/
# Aseprite 便携版（本机自编译，约 23M，不进版本库）
tools/aseprite/
