        </activity-alias>
        <activity-alias android:name=".LauncherChinchilla" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_pet_chinchilla_plain" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
