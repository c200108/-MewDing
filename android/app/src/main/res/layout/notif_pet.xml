<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏常驻宠物：ViewFlipper 逐帧切图实现动画（需求 T2/T3） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:autoStart="true"
        android:flipInterval="120">
        <ImageView android:id="@+id/f0" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/f2" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/f3" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/f4" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/f5" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/f6" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/f7" android:layout_width="match_parent" android:layout_height="match_parent" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1" />
        <TextView
            android:id="@+id/line"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
